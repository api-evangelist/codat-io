{
  "opencollection": "1.0.0",
  "info": {
    "name": "Codat Accounting Sync for Commerce API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sync for Commerce",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Sync latest commerce data",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.codat.io/companies/:companyId/sync/commerce/latest",
            "params": [
              {
                "name": "companyId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for a company."
              }
            ]
          },
          "docs": "Runs a commerce sync from the last successful sync to the specified date."
        },
        {
          "info": {
            "name": "Get commerce sync configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.codat.io/config/companies/:companyId/sync/commerce",
            "params": [
              {
                "name": "companyId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for a company."
              }
            ]
          },
          "docs": "Get commerce sync configuration"
        },
        {
          "info": {
            "name": "Set commerce sync configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.codat.io/config/companies/:companyId/sync/commerce",
            "params": [
              {
                "name": "companyId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for a company."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Set commerce sync configuration"
        },
        {
          "info": {
            "name": "Get commerce sync status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.codat.io/meta/companies/:companyId/sync/commerce/status",
            "params": [
              {
                "name": "companyId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for a company."
              }
            ]
          },
          "docs": "Get commerce sync status"
        }
      ]
    }
  ],
  "bundled": true
}